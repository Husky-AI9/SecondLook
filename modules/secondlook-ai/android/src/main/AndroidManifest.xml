<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application>
    <!-- The Quotekey keyboard: Check, Counter and Explain in any app. -->
    <service
      android:name="expo.modules.secondlookai.SecondLookKeyboardService"
      android:label="Quotekey"
      android:permission="android.permission.BIND_INPUT_METHOD"
      android:exported="true">
      <intent-filter>
        <action android:name="android.view.InputMethod" />
      </intent-filter>
      <meta-data android:name="android.view.im" android:resource="@xml/secondlook_keyboard" />
    </service>
  </application>
</manifest>
