# Copy to .env and fill in. .env is ignored by git; never commit real values.
# Firebase console → Project settings → Your apps → Web app → SDK setup and configuration.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# App Check on the web: reCAPTCHA Enterprise site key (Firebase console → App Check → your web app).
EXPO_PUBLIC_RECAPTCHA_SITE_KEY=
# Local web testing only: "true" prints a debug token in the browser console to register in
# the console, or paste a registered debug token here. Leave empty for the hosted build.
EXPO_PUBLIC_APPCHECK_DEBUG_TOKEN=

# Optional: Chrome origin-trial token for the Prompt API, so visitors get on-device Gemini Nano
# without changing a Chrome flag.
EXPO_PUBLIC_PROMPT_API_ORIGIN_TRIAL=

# Native builds (read by app.config.ts at build time, not bundled into JavaScript)
IOS_BUNDLE_ID=com.secondlook.app
ANDROID_PACKAGE=com.secondlook.app
APPCHECK_DEBUG=1
APPCHECK_DEBUG_TOKEN_IOS=
# STABLE, PREVIEW (Gemini Nano 4 full) or PREVIEW_FAST. PREVIEW needs the AICore developer preview.
ANDROID_ONDEVICE_OPTION=PREVIEW

# Plan A only: set to 1 when the iOS keyboard extension is part of the build.
EXPO_PUBLIC_KEYBOARD=0
EXPO_PUBLIC_KEYCHAIN_GROUP=
