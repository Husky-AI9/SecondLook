{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleSuffixes": [".web", ""],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    "paths": {
      "react-native": ["./shims/react-native.tsx"],
      "react-native-svg": ["./shims/svg.tsx"],
      "react-native-safe-area-context": ["./shims/others.tsx"],
      "expo": ["./shims/others.tsx"],
      "expo-status-bar": ["./shims/others.tsx"],
      "expo-font": ["./shims/others.tsx"],
      "@expo-google-fonts/dm-sans": ["./shims/others.tsx"],
      "expo-clipboard": ["./shims/others.tsx"],
      "expo-secure-store": ["./shims/others.tsx"],
      "@react-native-async-storage/async-storage": ["./shims/others.tsx"],
      "firebase/app": ["./shims/firebase.ts"],
      "firebase/ai": ["./shims/firebase.ts"],
      "firebase/app-check": ["./shims/firebase.ts"],
      "firebase/remote-config": ["./shims/firebase.ts"],
      "firebase/auth": ["./shims/firebase.ts"]
    }
  },
  "include": ["../../App.tsx", "../../index.ts", "../../src/**/*.ts", "../../src/**/*.tsx", "../../modules/**/*.ts", "shims/*", "types/*"],
  "exclude": ["../../src/**/__tests__/**", "../../src/ai/platform.native.ts"]
}
